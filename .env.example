# ICAN Academy Data Pipeline Configuration

# TypeDB Connection
TYPEDB_HOST=localhost
TYPEDB_PORT=1729
TYPEDB_DATABASE=ican_knowledge_graph

# PostgreSQL (Scheduling DB)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=scheduling_db

# SQLite Database Paths
SQLITE_ATTENDANCE_DB=/Users/icanacademy/attendance-checker/attendance.db
SQLITE_STUDENT_ATTENDANCE_DB=/Users/icanacademy/student-attendance-checker/student-attendance.db
SQLITE_COACHING_DB=/Users/icanacademy/academy-coaching-app/coaching.db
SQLITE_MARKETPLACE_DB=/Users/icanacademy/ican-app-marketplace/marketplace.db
SQLITE_DEMO_ASSESSMENT_DB=/Users/icanacademy/ican-demo-assessment/demo_assessments.db
SQLITE_INTERVIEWS_DB=/Users/icanacademy/interview-sheet-generator/server/interviews.db
SQLITE_REPORTS_DB=/Users/icanacademy/student-report-app/student_reports.db
SQLITE_N8N_DB=/Users/icanacademy/.n8n/database.sqlite

# Notion API
NOTION_API_KEY=your_notion_api_key_here
NOTION_EMPLOYEE_DB_ID=your_employee_database_id
NOTION_STUDENT_DB_ID=your_student_database_id
NOTION_CURRICULUM_DB_ID=your_curriculum_database_id

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080
API_DEBUG=true

# Sync Configuration
SYNC_INTERVAL_MINUTES=15
FULL_SYNC_HOUR=6
